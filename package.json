{
  "name": "@foss-earth/cubemap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/foss-earth/cubemap.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./preparation": {
      "types": "./dist/preparation.d.ts",
      "import": "./dist/preparation.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./schema.json": "./schema/representation.json",
    "./babylon": {
      "types": "./dist/browser/babylon.d.ts",
      "import": "./dist/browser/babylon.js"
    },
    "./shaders": {
      "types": "./dist/shaders.d.ts",
      "import": "./dist/shaders.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "PROVENANCE.json",
    "README.md",
    "NOTICE",
    "SOURCE_LINEAGE.json",
    "src",
    "tests",
    "fixtures",
    "scripts",
    "docs",
    "SOURCE_RECEIPT.json"
  ],
  "dependencies": {
    "@foss-earth/images": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "eslint": "9.39.4",
    "typescript-eslint": "8.59.3",
    "@foss-earth/renderer": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --maxWorkers=50%",
    "typecheck:consumer": "tsc -p tests/tsconfig.json --incremental --tsBuildInfoFile node_modules/.tmp/consumer.tsbuildinfo",
    "ci": "npm run check:conformance && npm run check:implementation",
    "check:implementation": "npm run typecheck && npm run lint && npm test && npm run build && npm run typecheck:consumer",
    "test:installed-consumer": "node scripts/check-installed-artifact.mjs",
    "check:conformance": "node node_modules/@foss-earth/ci/bin/conformance.mjs --consumer . --trusted-release .attribution-release.json --output-root build/common-conformance",
    "check:attribution": "node node_modules/@foss-earth/ci/bin/attribution.mjs --repo . --refs-file build/repository-split/intended-publication-refs.json"
  },
  "peerDependencies": {
    "@foss-earth/renderer": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@foss-earth/renderer": {
      "optional": true
    }
  }
}
